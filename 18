*{box-sizing:border-box}html,body{margin:0;background:#f7fbfa;color:#234d53;font:14px/1.6 "Microsoft YaHei","Noto Sans SC",sans-serif}body{padding:12px}.toolbar,.controls,#layers{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.toolbar{justify-content:space-between;margin-bottom:10px}.controls{margin:10px 0}button,select{border:1px solid #b6d2ce;border-radius:7px;padding:7px 12px;color:#24676a;background:white;font:inherit;cursor:pointer}button:hover{background:#e1f1eb}#status{min-height:34px;margin:8px 0;color:#426e70}#stage{height:470px;width:100%;border:1px solid #c8dcd6;border-radius:10px;overflow:hidden}#stage canvas{display:block}#layers{margin-top:10px}#layers button{font-size:12px}#bertviz{overflow-x:auto;min-height:400px;padding:10px;border:1px solid #c8dcd6;border-radius:10px;background:white}#vis{overflow:visible}a{color:#2b7f7f}#vis svg text{font-family:"Microsoft YaHei",sans-serif}
