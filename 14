window.addEventListener('message',e=>{if(e.source!==parent||e.data?.type!=='perf-ai-viewport')return;frameHeight=e.data.height;document.documentElement.style.setProperty('--chart-h',Math.max(250,Math.min(345,frameHeight-340))+'px');size()});
